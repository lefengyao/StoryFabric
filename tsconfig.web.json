{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "noUnusedLocals": false,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tsbuild/web",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "useDefineForClassFields": true,
    "paths": {
      "@/*": ["./src/renderer/src/*"]
    }
  },
  "include": ["src/renderer/src/**/*", "src/shared/**/*", "src/core/**/*"],
  "exclude": ["src/core/storage/nodeFileStore.ts", "src/core/usage/usageService.ts", "src/core/**/__tests__/**/*"]
}
