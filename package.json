{
  "name": "storyfabric",
  "version": "0.1.0",
  "description": "依托智能体的小说创作工作台",
  "main": "./out/main/index.js",
  "author": "StoryFabric",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "web:build": "vite build --config vite.web.config.ts",
    "server:build": "vite build --config vite.server.config.ts",
    "server:start": "node dist-server/index.mjs",
    "server:build:all": "npm run web:build && npm run server:build",
    "server:bundle": "node scripts/build-server-bundle.mjs",
    "dist": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-win.ps1",
    "dist:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-win.ps1",
    "mobile:build": "vite build --config vite.mobile.config.ts",
    "mobile:sync": "npm run mobile:build && cap sync android",
    "mobile:open": "cap open android"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^7.1.6",
    "@capacitor/core": "^7.6.9",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor/share": "^7.0.4",
    "js-yaml": "^4.3.2",
    "jszip": "^3.10.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "@codemirror/lang-markdown": "^6.5.2",
    "@radix-ui/react-dialog": "^1.1.23",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-force": "^3.0.10",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^5.2.0",
    "@xyflow/react": "^12.11.3",
    "codemirror": "^6.0.2",
    "d3-force": "^3.0.0",
    "diff": "^9.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.34.0",
    "png-to-ico": "^3.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tar": "^7.5.22",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "zustand": "^5.0.15"
  }
}
